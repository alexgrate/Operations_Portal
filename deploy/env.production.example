# Production .env for the Operations Portal on the Windows VM.
#
# Copy to the project root as .env and fill in every CHANGE ME.
# This file is committed; the real .env is gitignored and must stay that way.

# --- core -----------------------------------------------------------------

DJANGO_DEBUG=False

# Generate on the VM, do not reuse the development one:
#   .venv\Scripts\python.exe -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=CHANGE ME

# Every hostname the site answers to. Django refuses any request whose Host
# header is not listed here, so a missing entry is a hard 400.
DJANGO_ALLOWED_HOSTS=operation-portal.dash-mfb.com

# Full origins with the scheme, or every POST is rejected as a CSRF failure.
DJANGO_CSRF_TRUSTED_ORIGINS=https://operation-portal.dash-mfb.com

# Every link in every email is built from this. No trailing slash.
SITE_URL=https://operation-portal.dash-mfb.com

DJANGO_TIME_ZONE=Africa/Lagos

# --- behind IIS -----------------------------------------------------------

# IIS terminates TLS, so Django only ever sees plain HTTP on the loopback.
# Without this it thinks every request is insecure, redirects to HTTPS, and
# the two loop until the browser gives up. Only safe because the ARR rule sets
# the header itself and waitress is bound to 127.0.0.1.
DJANGO_USE_PROXY_SSL_HEADER=True

# Start at one hour. Raise to 31536000 only once HTTPS is proven on every
# subdomain: browsers remember it and it cannot be taken back quickly.
DJANGO_SECURE_HSTS_SECONDS=3600

# --- database -------------------------------------------------------------

DB_ENGINE=django.db.backends.postgresql
DB_NAME=operations_portal
DB_USER=operations_portal
DB_PASSWORD=CHANGE ME
DB_HOST=127.0.0.1
DB_PORT=5432

# --- email, Microsoft Graph -----------------------------------------------

# ROTATE THESE before going live. The development values were pasted in
# plaintext and must be considered compromised.
MS_GRAPH_TENANT_ID=CHANGE ME
MS_GRAPH_CLIENT_ID=CHANGE ME
MS_GRAPH_CLIENT_SECRET=CHANGE ME
MS_GRAPH_SENDER=robot@dash-mfb.com

# --- notifications --------------------------------------------------------

ASSIGNMENT_EMAILS_ENABLED=True
REMINDERS_ENABLED=True
REMINDER_MODE=milestones
REMINDER_MILESTONES=50,80
REMINDER_FINAL_MINUTES=15
REMINDER_OVERDUE_EVERY_MINUTES=1440
REMINDER_HOURS=8-18
APPROVAL_DIGESTS_ENABLED=True
APPROVAL_DIGEST_MIN_GAP_MINUTES=60
APPROVAL_DIGEST_EVERY_MINUTES=240

# --- limits ---------------------------------------------------------------

PAGE_SIZE=25

# Keep below the maxAllowedContentLength in deploy/web.config (50 MB), so an
# oversized file gets the friendly message rather than a bare IIS error.
MAX_UPLOAD_MB=10
