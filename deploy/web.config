<?xml version="1.0" encoding="UTF-8"?>
<!--
    IIS configuration for the Operations Portal.

    This is a server-rendered Django application. There is no React build, no
    dist folder and no /api prefix, so there is deliberately NO SPA fallback
    rule here. A fallback rule would swallow every Django URL and is the usual
    reason a Django site behind IIS returns the wrong page.

    Everything is proxied to waitress on 127.0.0.1:8002 - not 8000, because
    two other Django apps on this VM already hold the lower ports. The port
    must match the PORT environment variable on the DashPortal service.
    Static files are
    served by WhiteNoise from inside Django, which is why IIS needs no virtual
    directory and never touches the filesystem. That is intentional:
    mediafiles/ holds customer documents and must only ever be reachable
    through portal.views.attachment_download, which checks who is asking.

    Requires: URL Rewrite 2.1, ARR 3.0, and the ARR server-level proxy switch.
-->
<configuration>
  <system.webServer>

    <rewrite>
      <rules>

        <!--
            1. Let win-acme answer the Let's Encrypt challenge over plain HTTP.
            Must come before the HTTPS redirect, or renewal fails every 60 days
            with a redirect the validation server will not follow.
        -->
        <rule name="ACME challenge" stopProcessing="true">
          <match url="^\.well-known/acme-challenge/.*$" />
          <action type="None" />
        </rule>

        <!-- 2. Everything else is HTTPS only. -->
        <rule name="Force HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!--
            3. Hand the request to Django.

            X-Forwarded-Proto is what makes DJANGO_USE_PROXY_SSL_HEADER work.
            Without it Django believes every request arrived over plain HTTP,
            SECURE_SSL_REDIRECT sends it back to HTTPS, and the two loop until
            the browser gives up.
        -->
        <rule name="Proxy to Django" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:8002/{R:1}" />
        </rule>

      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <!--
            IIS caps request bodies at about 30 MB by default and rejects
            anything larger before Django sees it, with a bare IIS error page.
            Keep this comfortably above MAX_UPLOAD_MB so the friendly message
            from the upload view is what people actually get.
        -->
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <!-- Django sets its own; drop the ones IIS volunteers. -->
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>

    <!-- Stop IIS returning its own error pages for Django's 403/404/500. -->
    <httpErrors existingResponse="PassThrough" />

  </system.webServer>
</configuration>
