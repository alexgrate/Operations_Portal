# Copy to .env and fill in real values. .env is gitignored; this file is not.
# Every key the project reads is listed here. Anything left blank falls back
# to a development-safe default.

# ---------------------------------------------------------------------------
# Core  (REQUIRED IN PRODUCTION)
# ---------------------------------------------------------------------------

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# The app REFUSES TO START with DJANGO_DEBUG=False and no key set.
DJANGO_SECRET_KEY=

# Never True in production.
DJANGO_DEBUG=True

# Comma-separated hostnames this site answers to. Must be set in production -
# Django rejects any request whose Host header isn't listed.
# e.g. portal.dash-mfb.com,10.0.1.14
DJANGO_ALLOWED_HOSTS=

# Comma-separated full origins, scheme included. Required once served over
# HTTPS or every POST is rejected as a CSRF failure.
# e.g. https://portal.dash-mfb.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Displayed timezone. Timestamps are always stored in UTC.
DJANGO_TIME_ZONE=UTC

# ---------------------------------------------------------------------------
# HTTPS  (these default to ON whenever DJANGO_DEBUG is False)
# ---------------------------------------------------------------------------

# Override only if you need to. Leave unset for secure-by-default.
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True

# Set True when running behind a load balancer or reverse proxy that
# terminates TLS. Without it the SSL redirect loops forever.
DJANGO_USE_PROXY_SSL_HEADER=False

# HSTS: browsers cache this for the full duration and it cannot be undone
# quickly. Start at 3600, raise to 31536000 once HTTPS is confirmed working
# on every subdomain.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# ---------------------------------------------------------------------------
# Database  (defaults to the local SQLite file)
# ---------------------------------------------------------------------------

# SQLite cannot handle concurrent writers - move to Postgres before rollout.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=operations_portal
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=5432
# DB_CONN_MAX_AGE=60

# ---------------------------------------------------------------------------
# Email - Microsoft Graph  (password-reset messages)
# ---------------------------------------------------------------------------

# The Azure app registration needs the Mail.Send *application* permission
# with admin consent granted, and MS_GRAPH_SENDER must be a real mailbox.
# Leave blank to print emails to the console instead of sending them.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER=robot@dash-mfb.com

# ---------------------------------------------------------------------------
# Google sign-in  (optional)
# ---------------------------------------------------------------------------

# From the Google Cloud console, OAuth 2.0 Client ID (Web application).
# Authorised redirect URI:
#   https://<your-host>/accounts/google/login/callback/
# Leave blank and the "Continue with Google" button is hidden entirely.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
