# Copy to .env and fill in real values. .env is gitignored; this file is not.

# Microsoft Graph app registration used to send the password-reset email.
# Needs the Mail.Send *application* permission with admin consent granted.
# Leave these blank to fall back to printing emails to the console.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER=robot@dash-mfb.com

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
