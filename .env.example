# Copy to .env and fill in real values. .env is gitignored; this file is not.
# Every key the project reads is listed here. Anything left blank falls back
# to a development-safe default.

# ---------------------------------------------------------------------------
# Core  (REQUIRED IN PRODUCTION)
# ---------------------------------------------------------------------------

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# The app REFUSES TO START with DJANGO_DEBUG=False and no key set.
DJANGO_SECRET_KEY=

# Never True in production.
DJANGO_DEBUG=True

# Comma-separated hostnames this site answers to. Must be set in production -
# Django rejects any request whose Host header isn't listed.
# e.g. portal.dash-mfb.com,10.0.1.14
DJANGO_ALLOWED_HOSTS=

# Comma-separated full origins, scheme included. Required once served over
# HTTPS or every POST is rejected as a CSRF failure.
# e.g. https://portal.dash-mfb.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Displayed timezone. Timestamps are always stored in UTC.
DJANGO_TIME_ZONE=UTC

# ---------------------------------------------------------------------------
# HTTPS  (these default to ON whenever DJANGO_DEBUG is False)
# ---------------------------------------------------------------------------

# Override only if you need to. Leave unset for secure-by-default.
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True

# Set True when running behind a load balancer or reverse proxy that
# terminates TLS. Without it the SSL redirect loops forever.
DJANGO_USE_PROXY_SSL_HEADER=False

# HSTS: browsers cache this for the full duration and it cannot be undone
# quickly. Start at 3600, raise to 31536000 once HTTPS is confirmed working
# on every subdomain.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False

# ---------------------------------------------------------------------------
# Database  (defaults to the local SQLite file)
# ---------------------------------------------------------------------------

# SQLite cannot handle concurrent writers - move to Postgres before rollout.
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=operations_portal
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=5432
# DB_CONN_MAX_AGE=60

# ---------------------------------------------------------------------------
# Email - Microsoft Graph  (password-reset messages)
# ---------------------------------------------------------------------------

# The Azure app registration needs the Mail.Send *application* permission
# with admin consent granted, and MS_GRAPH_SENDER must be a real mailbox.
# Leave blank to print emails to the console instead of sending them.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER=robot@dash-mfb.com



# ---------------------------------------------------------------------------
# Task attachments
# ---------------------------------------------------------------------------

# Largest single file a person may attach to a task, in megabytes.
# The web server in front of Django has its own limit too - nginx defaults to
# 1 MB, so raise client_max_body_size to match or uploads fail before Django
# ever sees them.
MAX_UPLOAD_MB=10


# ---------------------------------------------------------------------------
# Deadline reminders
# ---------------------------------------------------------------------------

# The reminder emails are sent by a cron job, which has no web request to work
# out the site address from. Every link in every reminder is built from this,
# so get it wrong and they all point somewhere useless. No trailing slash.
SITE_URL=https://portal.dash-mfb.com

REMINDERS_ENABLED=True

# How the chasing is paced.
#   milestones  fractions of each task's own deadline, so a 2 hour job and a
#               2 day job each get the same small number of emails
#   interval    a fixed clock, the same for every task whatever its target
REMINDER_MODE=milestones

# Percentages of the way to the deadline at which to email, for milestone
# mode. "50,80" on a 24 hour task means one at 12 hours and one at 19h12m.
REMINDER_MILESTONES=50,80

# Interval mode only: the gap between reminders, and the most to send per task.
REMINDER_EVERY_MINUTES=30
REMINDER_MAX_PER_TASK=8

# The one-off last call, sent once when this many minutes remain.
REMINDER_FINAL_MINUTES=15

# Once a task is late, chasing hourly does not make it finish sooner. Daily.
REMINDER_OVERDUE_EVERY_MINUTES=1440

# Routine reminders are held back outside these hours, so a deadline running
# overnight does not email anyone at 3am. Use 0-0 to send at any hour.
# The final warning ignores this, which is the whole point of it.
REMINDER_HOURS=8-18

APPROVAL_DIGESTS_ENABLED=True

# Shortest gap between two digests to the same person, so a busy morning does
# not email a Team Lead every time a task is raised.
APPROVAL_DIGEST_MIN_GAP_MINUTES=60

# How often to send again when nothing new has arrived but work is still
# sitting there unactioned.
APPROVAL_DIGEST_EVERY_MINUTES=240
